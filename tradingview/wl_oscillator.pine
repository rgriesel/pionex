//@version=5
// ─────────────────────────────────────────────────────────────────────────────
// WL Oscillator for TradingView (Wave Lab, personal use)
//
// Our own code, written from the public descriptions, docs and guide video of
// ChartPrime's Prime Oscillators. It is NOT their code and only approximates
// their tools. Keep it as a PRIVATE script: do not publish it, and never under
// ChartPrime's names. Watch-only: it draws and alerts, it places no orders.
//
// Modes: Prime, Trend Fusion, MVP (their "Prime Oscillators Pro" suite) and
// Prime+ / Money (their "Prime Oscillator+"). Same rules as Wave Lab's
// WL Oscillator (wavelab/index.html, WLOSC); small differences come from
// TradingView's own built-ins (EMA seeding, pivot ties).
// Hover any signal mark for what it means (setting: "Hover tips on signals").
// ─────────────────────────────────────────────────────────────────────────────
indicator("WL Oscillator", shorttitle = "WL Osc", overlay = false, max_lines_count = 500, max_labels_count = 500)

// ── settings ────────────────────────────────────────────────────────────────
mode    = input.string("Prime", "Mode", options = ["Prime", "Trend Fusion", "MVP", "Prime+", "Money"])
tipsOn  = input.bool(true, "Hover tips on signals")
G1 = "Prime / Trend Fusion"
bandsOn = input.bool(true,  "Prime: band", group = G1)
brkOn   = input.bool(true,  "Prime: band-break dots", group = G1)
divOn   = input.bool(true,  "Prime: divergences", group = G1)
fDivOn  = input.bool(false, "Trend Fusion: divergences", group = G1)
pivK    = input.int(5,  "Pivot bars each side", minval = 1, group = G1)
minD    = input.int(5,  "Divergence min distance (bars)", minval = 1, group = G1)
maxD    = input.int(35, "Divergence max distance (bars)", minval = 2, group = G1)
G2 = "Prime+ / Money"
n1      = input.int(10, "Channel length", minval = 1, group = G2)
n2      = input.int(21, "Average length", minval = 1, group = G2)
mfiLen  = input.int(14, "MFI length", minval = 1, group = G2)
mfs     = input.int(5,  "Money-flow smoothing", minval = 1, group = G2)
ob      = input.int(53, "Overbought / oversold level", minval = 1, group = G2)
lookbk  = input.int(60, "Divergence lookback (bars)", minval = 2, group = G2)
vwapLen = input.int(50, "VWAP length", minval = 2, group = G2)
score7  = input.bool(false, "True-7 score", group = G2)

isPrime = mode == "Prime"
isFus   = mode == "Trend Fusion"
isMvp   = mode == "MVP"
isPlus  = mode == "Prime+"
isMoney = mode == "Money"

// ── colours ─────────────────────────────────────────────────────────────────
TEAL    = #26e0c0
PINK    = #ff3d71
ORANGE  = #ffa726
BLUE    = #42a5f5
YELLOW  = #ffd54f
MINT    = #69f0c0
SALMON  = #ff6b6b
OBRED   = #9b1111
OSGREEN = #0f8a2f
GREEN   = #00e676
RED     = #ff1744
DKBLUE  = #3d5afe
PURPLE  = #aa00ff
YEL2    = #ffd600
HIDBULL = #80cbc4
HIDBEAR = #ffab91
FGREEN  = #13b886
FRED    = #e8213a
KAMAC   = #5c6bc0
MVPB    = #3d8bfd
MVPP    = #9b4dff
GRAY    = #6b7280
LGREEN  = #4caf50

// ── helpers ─────────────────────────────────────────────────────────────────
tip(string t) =>
    tipsOn ? t : ""

mark(float y, string st, color c, string t) =>
    label.new(bar_index, y, "", style = st, color = c, textcolor = c, size = size.tiny, tooltip = tip(t))

ring(float y, color c, string t) =>
    label.new(bar_index, y, "◉", style = label.style_none, textcolor = c, size = size.normal, tooltip = tip(t))

// Divergences on y, at the bar that confirms the pivot (pivK bars after it):
// 1/-1 regular bull/bear, 2/-2 hidden bull/bear, 3/-3 multiple (chained regular).
f_div(float y, int k, int mn, int mx) =>
    var int   lIdx   = na
    var float lVal   = na
    var float lPx    = na
    var int   hIdx   = na
    var float hVal   = na
    var float hPx    = na
    var int   bullTo = -1
    var int   bearTo = -1
    int   code = 0
    int   x1   = na
    float y1   = na
    int   x2   = na
    float y2   = na
    pl = ta.pivotlow(y, k, k)
    ph = ta.pivothigh(y, k, k)
    if not na(pl)
        j  = bar_index - k
        px = low[k]
        if not na(lIdx) and j - lIdx >= mn and j - lIdx <= mx
            if px < lPx and pl > lVal
                code := lIdx == bullTo ? 3 : 1
                bullTo := j
            else if px > lPx and pl < lVal
                code := 2
            if code != 0
                x1 := lIdx
                y1 := lVal
                x2 := j
                y2 := pl
        lIdx := j
        lVal := pl
        lPx  := px
    if not na(ph)
        j  = bar_index - k
        px = high[k]
        if code == 0 and not na(hIdx) and j - hIdx >= mn and j - hIdx <= mx
            if px > hPx and ph < hVal
                code := hIdx == bearTo ? -3 : -1
                bearTo := j
            else if px < hPx and ph > hVal
                code := -2
            if code != 0
                x1 := hIdx
                y1 := hVal
                x2 := j
                y2 := ph
        hIdx := j
        hVal := ph
        hPx  := px
    [code, x1, y1, x2, y2]

divLine(int x1, float y1, int x2, float y2, int code, color cBull, color cBear) =>
    c = code == 1 ? cBull : code == -1 ? cBear : code == 2 ? HIDBULL : code == -2 ? HIDBEAR : YEL2
    line.new(x1, y1, x2, y2, color = c, width = math.abs(code) == 3 ? 2 : 1, style = math.abs(code) == 2 ? line.style_dashed : line.style_solid)

divTip(int code) =>
    switch code
        1  => "Regular bullish divergence: price made a lower low but the oscillator a higher low. Selling is weakening. Drawn once confirmed, a few candles after the low."
        -1 => "Regular bearish divergence: price made a higher high but the oscillator a lower high. Buying is weakening."
        2  => "Hidden bullish divergence (dashed): price made a higher low but the oscillator a lower low. Often a dip inside an uptrend that may continue up."
        -2 => "Hidden bearish divergence (dashed): price made a lower high but the oscillator a higher high. Often a bounce inside a downtrend."
        3  => "Multiple bullish divergence (thick yellow): three or more lows in a row diverging. The strongest kind."
        => "Multiple bearish divergence (thick yellow): three or more highs in a row diverging. The strongest kind."

// ── shared inputs to several modes ──────────────────────────────────────────
rsi14 = ta.rsi(close, 14)
mfi14 = ta.mfi(hlc3, 14)
[macdL, macdS, macdH] = ta.macd(close, 12, 26, 9)
m20 = ta.sma(close, 20)
s20 = ta.stdev(close, 20)
z   = s20 > 0 ? (close - m20) / s20 : 0.0

// ── Prime+ / Money (WaveTrend main line, MFI cloud, 7 conditions) ───────────
esa  = ta.ema(hlc3, n1)
dd   = ta.ema(math.abs(hlc3 - esa), n1)
ci   = dd == 0 ? 0.0 : (hlc3 - esa) / (0.015 * dd)
wt1  = ta.ema(ci, n2)
wt2  = ta.sma(wt1, 4)
mfiP = ta.mfi(hlc3, mfiLen)
mf   = ta.ema((mfiP - 50) * 2, mfs)
e20  = ta.ema(close, 20)
e50  = ta.ema(close, 50)
vw50 = math.sum(hlc3 * volume, vwapLen) / math.sum(volume, vwapLen)
sd50 = ta.stdev(close, vwapLen)
bull = (close > e20 ? 1 : 0) + (e20 > e50 ? 1 : 0) + (rsi14 > 50 ? 1 : 0) + (macdH > 0 ? 1 : 0) + (wt1 > wt2 ? 1 : 0) + (mfiP > 50 ? 1 : 0) + (close > vw50 ? 1 : 0)
wtUp = ta.crossover(wt1, wt2)
wtDn = ta.crossunder(wt1, wt2)
rev  = wtUp and wt1 < -ob ? 1 : wtDn and wt1 > ob ? -1 : 0
fair = close < vw50 - 2 * sd50 ? 1 : close > vw50 + 2 * sd50 ? -1 : 0
sv   = close > open ? volume : close < open ? -volume : 0.0
vm   = ta.ema(sv, 10) / ta.ema(volume, 10)
[dW, dWx1, dWy1, dWx2, dWy2] = f_div(wt1, pivK, 1, lookbk)
divX = (dW == 1 or dW == 3) and dWy2 < 0 ? 1 : (dW == -1 or dW == -3) and dWy2 > 0 ? -1 : 0
[dM, dMx1, dMy1, dMx2, dMy2] = f_div(mf, pivK, 1, lookbk)
mfdiv = (dM == 1 or dM == 3) and dMy2 < 0 ? 1 : (dM == -1 or dM == -3) and dMy2 > 0 ? -1 : 0
var int tstate = 0
int trendA = 0
if bull >= 6 and tstate != 1
    trendA := 1
    tstate := 1
else if bull <= 1 and tstate != -1
    trendA := -1
    tstate := -1
bsRevUp = ta.barssince(rev == 1)
bsRevDn = ta.barssince(rev == -1)
bsDivUp = ta.barssince(divX == 1)
bsDivDn = ta.barssince(divX == -1)
var int lastDiaUp = -100
var int lastDiaDn = -100
int dia = 0
if ((rev == 1 and bsDivUp <= 5) or (divX == 1 and bsRevUp <= 5)) and bar_index - lastDiaUp > 5
    dia := 1
    lastDiaUp := bar_index
else if ((rev == -1 and bsDivDn <= 5) or (divX == -1 and bsRevDn <= 5)) and bar_index - lastDiaDn > 5
    dia := -1
    lastDiaDn := bar_index

// ── Prime (0-100 ribbon of RSI + MFI + stochastic) ──────────────────────────
rawP = (rsi14 + mfi14 + ta.stoch(close, high, low, 14)) / 3
fast = ta.ema(rawP, 5)
slow = ta.ema(fast, 5)
midB = ta.sma(fast, 20)
sdB  = ta.stdev(fast, 20)
upB  = midB + 2 * sdB
loB  = midB - 2 * sdB
fUpB = ta.crossover(fast, upB)
fDnB = ta.crossunder(fast, loB)
fUp  = ta.crossover(fast, slow)
fDn  = ta.crossunder(fast, slow)
brk  = fUpB ? -1 : fDnB ? 1 : 0
tri  = fUp and fast < 40 ? 1 : fDn and fast > 60 ? -1 : 0
obos = fast >= 80 ? -1 : fast <= 20 ? 1 : 0
[dP, dPx1, dPy1, dPx2, dPy2] = f_div(fast, pivK, minD, maxD)
peak = (dP == 1 or dP == 3) and dPy2 <= 25 ? 1 : (dP == -1 or dP == -3) and dPy2 >= 75 ? -1 : 0

// ── Trend Fusion (price-volume wave vs an adaptive line, MFI behind) ────────
vwF  = math.sum(close * volume, 21) / math.sum(volume, 21)
atrF = ta.atr(21)
wave = ta.ema((close - vwF) / atrF * 25, 5)
volW = math.sum(math.abs(wave - wave[1]), 10)
er   = volW > 0 ? math.abs(wave - wave[10]) / volW : 0.0
sc   = math.pow(er * (2.0 / 3 - 2.0 / 31) + 2.0 / 31, 2)
var float kama = na
kama := na(kama[1]) ? wave : kama[1] + sc * (wave - kama[1])
mfw    = ta.ema((mfi14 - 50) * 2, 3)
trendF = na(wave) or na(kama) ? 0 : wave > kama ? 1 : -1
strong = trendF != 0 and ((trendF > 0 and mfw > 0) or (trendF < 0 and mfw < 0))
wDn    = wave < wave[1] and wave[1] >= wave[2]
wUp    = wave > wave[1] and wave[1] <= wave[2]
dotF   = wDn and z >= 2 and mfi14 >= 65 ? -1 : wUp and z <= -2 and mfi14 <= 35 ? 1 : wDn and z >= 1.5 ? -2 : wUp and z <= -1.5 ? 2 : wDn and wave >= 60 and mfw < mfw[1] ? -3 : 0
var runs = array.new_int(0)
var int run = 0
if trendF != 0 and trendF == trendF[1]
    run += 1
else
    if run > 0
        array.push(runs, run)
        if array.size(runs) > 20
            array.shift(runs)
    run := trendF != 0 ? 1 : 0
diaF = (dotF == 1 or dotF == -1) and array.size(runs) >= 5 and run >= 1.5 * array.median(runs) ? dotF : 0
[dF, dFx1, dFy1, dFx2, dFy2] = f_div(wave, pivK, minD, maxD)

// ── MVP (MACD scaled to -100..100, bottom bars) ─────────────────────────────
mxM  = ta.highest(math.abs(macdL), 100)
mvpL = mxM > 0 ? 100 * macdL / mxM : na
mvpS = ta.ema(mvpL, 9)
mUp  = ta.crossover(mvpL, mvpS)
mDn  = ta.crossunder(mvpL, mvpS)
sigM = mUp and mvpL < -40 ? 1 : mDn and mvpL > 40 ? -1 : 0
relv = math.min(3.0, volume / ta.sma(volume, 50))
bsM  = z < -1 ? math.min(1.0, (-z - 1) / 1.5) * (rsi14 < 40 ? 1.0 : 0.5) : 0.0

// ── plots: Prime+ / Money ───────────────────────────────────────────────────
plusAny = isPlus or isMoney
mfShow  = isMoney ? mf * 1.2 : mf
plot(plusAny ? mfShow : na, "Money flow", color = mf >= 0 ? color.new(TEAL, isMoney ? 35 : 70) : color.new(PINK, isMoney ? 35 : 70), style = plot.style_area)
vmTr = 100 * (1 - math.min(1, 0.15 + math.abs(vm)))
plot(plusAny ? -122 : na, "Volume matrix", color = vm >= 0 ? color.new(TEAL, vmTr) : color.new(PINK, vmTr), linewidth = 4)
plot(isPlus ? wt2 : na, "Signal line", color = color.new(color.gray, 30))
plot(isPlus ? wt1 : na, "Main line", color = wt1 >= wt2 ? TEAL : PINK, linewidth = 2)
plot(isPlus ? ob : na, "Overbought", color = color.new(color.gray, 50), style = plot.style_circles)
plot(isPlus ? -ob : na, "Oversold", color = color.new(color.gray, 50), style = plot.style_circles)
plot(isPlus or isMoney or isFus or isMvp ? 0 : na, "Zero", color = color.new(color.gray, 60), style = plot.style_circles)
powTr(int s) => 100.0 - 100.0 * (s - 4) / 3.0
plotshape(isPlus and bull >= 5 ? 120 : na, "Power bars (bullish)", shape.square, location.absolute, color.new(TEAL, powTr(bull)), size = size.tiny)
plotshape(isPlus and bull <= 2 ? -115 : na, "Power bars (bearish)", shape.square, location.absolute, color.new(PINK, powTr(7 - bull)), size = size.tiny)
plotshape(isPlus and fair == 1 and fair[1] != 1 ? -108 : na, "Oversold (fair value)", shape.square, location.absolute, ORANGE, size = size.tiny)
plotshape(isPlus and fair == -1 and fair[1] != -1 ? 106 : na, "Overbought (fair value)", shape.square, location.absolute, ORANGE, size = size.tiny)

if isPlus and rev != 0
    mark(wt1, label.style_circle, rev > 0 ? TEAL : PINK, rev > 0 ? "Momentum dot (bullish): the main line twisted up through its signal while oversold - a possible bottom." : "Momentum dot (bearish): the main line twisted down through its signal while overbought - a possible top.")
if isPlus and divX != 0
    divLine(dWx1, dWy1, dWx2, dWy2, dW, TEAL, PINK)
    mark(113, label.style_circle, BLUE, (divX > 0 ? "Bullish" : "Bearish") + " divergence with peak-seeker dot: price and the main line disagree - " + (divX > 0 ? "selling" : "buying") + " is losing strength.")
if plusAny and mfdiv != 0
    mark(mfShow, label.style_circle, YELLOW, mfdiv > 0 ? "Money-flow divergence (bullish): money is still flowing out, but less than at the previous low while price made a lower low." : "Money-flow divergence (bearish): money is still flowing in, but less than at the previous high while price made a higher high.")
if isPlus and trendA != 0
    mark(trendA > 0 ? -100 : 99, trendA > 0 ? label.style_triangleup : label.style_triangledown, trendA > 0 ? TEAL : PINK, trendA > 0 ? "Uptrend arrow: the trend rank reached 6-7 of 7 bullish conditions after being bearish." : "Downtrend arrow: the trend rank fell to 0-1 of 7 after being bullish.")
if isPlus and dia != 0
    label.new(bar_index, wt1 + (dia > 0 ? -14 : 14), "", style = label.style_diamond, color = dia > 0 ? TEAL : PINK, size = size.small, tooltip = tip("Diamond shift: a momentum dot and a same-side divergence within 6 candles. Rare; the strongest reversal marker."))
if isPlus and score7 and (bull == 7 or bull == 0) and bull != bull[1]
    label.new(bar_index, 90, "7", style = label.style_none, textcolor = bull == 7 ? TEAL : PINK, size = size.small, tooltip = tip("True-7: all 7 trend conditions agree - an extreme that can come before a reversal."))

// ── plots: Prime ────────────────────────────────────────────────────────────
pU = plot(isPrime and bandsOn ? upB : na, "Band top", color = na)
pM = plot(isPrime and bandsOn ? midB : na, "Band middle", color = na)
pL = plot(isPrime and bandsOn ? loB : na, "Band bottom", color = na)
fill(pU, pM, color = color.new(SALMON, 88), title = "Band, bearish half")
fill(pM, pL, color = color.new(MINT, 88), title = "Band, bullish half")
plot(isPrime ? 80 : na, "Macro overbought (80)", color = OBRED, linewidth = 4)
plot(isPrime ? 20 : na, "Macro oversold (20)", color = OSGREEN, linewidth = 4)
plot(isPrime ? 50 : na, "Midline (50)", color = color.new(color.gray, 50), style = plot.style_circles)
pF = plot(isPrime ? fast : na, "Ribbon fast", color = fast >= slow ? MINT : SALMON)
pS = plot(isPrime ? slow : na, "Ribbon slow", color = fast >= slow ? MINT : SALMON)
fill(pF, pS, color = fast >= slow ? color.new(MINT, 15) : color.new(SALMON, 15), title = "Ribbon")
plotshape(isPrime and obos == -1 ? 88 : na, "OB boxes", shape.square, location.absolute, ORANGE, size = size.tiny)
plotshape(isPrime and obos == 1 ? 12 : na, "OS boxes", shape.square, location.absolute, ORANGE, size = size.tiny)

if isPrime and obos[1] == -1 and obos != -1
    label.new(bar_index - 1, 88, "OB", style = label.style_label_left, color = color.new(color.black, 100), textcolor = ORANGE, size = size.tiny, tooltip = tip("OB boxes: the ribbon is at or above 80 (overbought) - buyers look exhausted. The longer the row of boxes, the more overextended."))
if isPrime and obos[1] == 1 and obos != 1
    label.new(bar_index - 1, 12, "OS", style = label.style_label_left, color = color.new(color.black, 100), textcolor = ORANGE, size = size.tiny, tooltip = tip("OS boxes: the ribbon is at or below 20 (oversold) - sellers look exhausted. The longer the row of boxes, the more overextended."))
if isPrime and brkOn and brk != 0
    mark(fast, label.style_circle, brk > 0 ? GREEN : RED, brk > 0 ? "Band break (green): the ribbon dropped out below its band - a micro oversold point; it tends to come back toward the middle." : "Band break (red): the ribbon broke out above its band - a micro overbought point.")
if isPrime and tri != 0
    mark(tri > 0 ? 6 : 94, tri > 0 ? label.style_triangleup : label.style_triangledown, tri > 0 ? GREEN : RED, tri > 0 ? "Possible reversal triangle (bullish): the ribbon twisted up while low (below 40)." : "Possible reversal triangle (bearish): the ribbon twisted down while high (above 60).")
if isPrime and divOn and dP != 0
    divLine(dPx1, dPy1, dPx2, dPy2, dP, GREEN, RED)
    mark(dPy2, label.style_xcross, color.new(color.white, 100), divTip(dP))
if isPrime and peak != 0
    mark(peak > 0 ? 0 : 100, label.style_circle, BLUE, "Peak seeker: a regular divergence that formed while the ribbon was " + (peak > 0 ? "oversold (25 or lower)." : "overbought (75 or higher).") + " The rarest Prime signal.")

// ── plots: Trend Fusion ─────────────────────────────────────────────────────
plot(isFus ? mfw : na, "Money flow (background)", color = mfw >= 0 ? color.new(BLUE, 78) : color.new(FRED, 78), style = plot.style_area)
plot(isFus ? 60 : na, "Upper line (+60)", color = FRED)
plot(isFus ? -60 : na, "Lower line (-60)", color = FGREEN)
pW = plot(isFus ? wave : na, "Fusion wave", color = trendF > 0 ? FGREEN : FRED, linewidth = 2)
pK = plot(isFus ? kama : na, "Adaptive line", color = KAMAC)
fCol   = trendF > 0 ? FGREEN : FRED
fTop   = math.max(nz(wave), nz(kama))
fBot   = math.min(nz(wave), nz(kama))
fStr   = color.new(fCol, strong ? 10 : 45)
fFaint = color.new(fCol, 92)
fill(pW, pK, fTop, fBot, trendF > 0 ? fStr : fFaint, trendF > 0 ? fFaint : fStr, title = "Wave fill")

if isFus and dotF != 0
    dc = dotF == 1 ? GREEN : dotF == -1 ? RED : dotF == 2 ? DKBLUE : dotF == -2 ? PURPLE : YEL2
    dt = dotF == 1 ? "Regular bullish dot: price far below its 20-candle average (2+ SD), weak money flow (MFI 35 or lower) and the wave turning up." : dotF == -1 ? "Regular bearish dot: price far above its 20-candle average (2+ SD), strong money flow (MFI 65 or higher) and the wave turning down." : dotF == 2 ? "Special bullish dot (dark blue): price stretched below its average (1.5+ SD) with the wave turning up. Weaker than regular." : dotF == -2 ? "Special bearish dot (purple): price stretched above its average (1.5+ SD) with the wave turning down. Weaker than regular." : "Caution bearish dot (yellow): the wave turned down from high up (+60) while money flow fades - an early warning, lower probability."
    ring(dotF > 0 ? -72 : 72, dc, dt)
if isFus and diaF != 0
    label.new(bar_index, diaF > 0 ? -86 : 86, "", style = label.style_diamond, color = YEL2, size = size.small, tooltip = tip("Yellow diamond: a regular dot after an unusually long trend run (1.5x the typical run). The rarest Fusion signal, aimed at tops and bottoms."))
if isFus and fDivOn and dF != 0
    divLine(dFx1, dFy1, dFx2, dFy2, dF, GREEN, RED)
    mark(dFy2, label.style_xcross, color.new(color.white, 100), divTip(dF))

// ── plots: MVP ──────────────────────────────────────────────────────────────
plot(isMvp ? 100 : na, "Overextended up (+100)", color = MVPP, linewidth = 2)
plot(isMvp ? -100 : na, "Overextended down (-100)", color = MVPB, linewidth = 2)
plot(isMvp ? -100 + relv / 3 * 30 : na, "Bottom bars", color = bsM > 0.25 ? color.new(LGREEN, 70 - 70 * bsM) : color.new(GRAY, 65), style = plot.style_columns, histbase = -100)
pV = plot(isMvp ? mvpL : na, "MVP line", color = mvpL >= mvpS ? MVPB : MVPP)
pG = plot(isMvp ? mvpS : na, "MVP signal", color = color.new(#dbe4ff, 40))
fill(pV, pG, color = mvpL >= mvpS ? color.new(MVPB, 20) : color.new(MVPP, 20), title = "MVP ribbon")

if isMvp and sigM != 0
    mark(sigM > 0 ? -112 : 112, sigM > 0 ? label.style_triangleup : label.style_triangledown, sigM > 0 ? MVPB : MVPP, sigM > 0 ? "Buy arrow: the MVP ribbon twisted up while low (below -40)." : "Sell arrow: the MVP ribbon twisted down while high (above +40).")

// ── alerts (Create Alert -> Condition: WL Oscillator -> pick one) ───────────
alertcondition(dP == 1 or dP == 3, "Prime: bullish divergence", "WL Osc Prime: bullish divergence on {{ticker}} {{interval}}")
alertcondition(dP == -1 or dP == -3, "Prime: bearish divergence", "WL Osc Prime: bearish divergence on {{ticker}} {{interval}}")
alertcondition(tri == 1, "Prime: bullish reversal triangle", "WL Osc Prime: bullish reversal triangle on {{ticker}} {{interval}}")
alertcondition(tri == -1, "Prime: bearish reversal triangle", "WL Osc Prime: bearish reversal triangle on {{ticker}} {{interval}}")
alertcondition(peak != 0, "Prime: peak seeker", "WL Osc Prime: peak seeker on {{ticker}} {{interval}}")
alertcondition(obos != 0 and obos[1] != obos, "Prime: overbought / oversold", "WL Osc Prime: ribbon entered overbought/oversold on {{ticker}} {{interval}}")
alertcondition(dotF > 0, "Trend Fusion: bullish reversal dot", "WL Osc Fusion: bullish reversal dot on {{ticker}} {{interval}}")
alertcondition(dotF < 0, "Trend Fusion: bearish reversal dot", "WL Osc Fusion: bearish reversal dot on {{ticker}} {{interval}}")
alertcondition(diaF != 0, "Trend Fusion: yellow diamond", "WL Osc Fusion: yellow diamond on {{ticker}} {{interval}}")
alertcondition(sigM == 1, "MVP: buy arrow", "WL Osc MVP: buy arrow on {{ticker}} {{interval}}")
alertcondition(sigM == -1, "MVP: sell arrow", "WL Osc MVP: sell arrow on {{ticker}} {{interval}}")
alertcondition(rev != 0, "Prime+: momentum dot", "WL Osc Prime+: momentum dot on {{ticker}} {{interval}}")
alertcondition(dia != 0, "Prime+: diamond shift", "WL Osc Prime+: diamond shift on {{ticker}} {{interval}}")
alertcondition(relv >= 2.5, "Unusual volume (2.5x average)", "WL Osc: unusual volume on {{ticker}} {{interval}}")
