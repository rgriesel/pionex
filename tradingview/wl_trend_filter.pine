//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// WL Trend Filter (daily EMA50, spot, long-only) — Wave Lab / Pionex lab rule
//
// The one rule that passed the lab's pre-registered tests (swing/trend.py):
//   hold spot while the DAILY close is above its 50-day EMA, otherwise hold cash.
//   BTC + ETH, 2023-04..2026-10 and out of sample 2017-11..2023-03: higher Sharpe
//   and smaller drawdowns than buying and holding; robust for EMA lengths 20-120.
// Backtests are not proof of future profit. Drawdowns of 30-65% still happened.
// Watch-only on TradingView: it backtests and alerts, it places no orders.
//
// Works on any chart timeframe: it reads the previous COMPLETED daily candle
// (no look-ahead), so a flip shows the bar after the daily close (00:00 UTC on
// UTC exchanges). Fees: Pionex 0.05% + 0.02% slippage per side.
// Alerts: Create Alert -> Condition "WL Trend Filter" -> "alert() function calls".
// ─────────────────────────────────────────────────────────────────────────────
strategy("WL Trend Filter (daily EMA50, long-only)", shorttitle = "WL Trend", overlay = true,
     initial_capital = 1000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 0,
     pyramiding = 0, process_orders_on_close = false)

len     = input.int(50, "Daily EMA length", minval = 5)
volTgt  = input.float(40, "Volatility target for the size hint (%)", minval = 5) / 100
showEma = input.bool(true, "Show the daily EMA on the chart")

// previous completed daily candle (lookahead_on + [1] = no repainting, no future data)
[dClose, dEma, dVol] = request.security(syminfo.tickerid, "D", [close[1], ta.ema(close, len)[1], ta.stdev(math.log(close / close[1]), 30)[1] * math.sqrt(365)], lookahead = barmerge.lookahead_on)

inTrend = not na(dEma) and dClose > dEma
flipIn  = inTrend and not inTrend[1]
flipOut = not inTrend and inTrend[1]
sizeHint = na(dVol) or dVol <= 0 ? 1.0 : math.min(1.0, volTgt / dVol)

if flipIn
    strategy.entry("Trend", strategy.long, comment = "IN")
    alert(syminfo.ticker + ": daily close " + str.tostring(dClose, format.mintick) + " above EMA" + str.tostring(len) + " " + str.tostring(dEma, format.mintick) + " - rule IN (long spot). Volatility-sized hint: " + str.tostring(sizeHint * 100, "#") + "% of capital.", alert.freq_once_per_bar)
if flipOut
    strategy.close("Trend", comment = "OUT")
    alert(syminfo.ticker + ": daily close " + str.tostring(dClose, format.mintick) + " below EMA" + str.tostring(len) + " " + str.tostring(dEma, format.mintick) + " - rule OUT (cash).", alert.freq_once_per_bar)

plot(showEma ? dEma : na, "Daily EMA", color = inTrend ? color.new(#13b886, 0) : color.new(#e8213a, 0), linewidth = 2)
bgcolor(inTrend ? color.new(#13b886, 92) : na, title = "Rule IN")
plotshape(flipIn, "IN", shape.labelup, location.belowbar, color.new(#13b886, 0), text = "IN", textcolor = color.white, size = size.small)
plotshape(flipOut, "OUT", shape.labeldown, location.abovebar, color.new(#e8213a, 0), text = "OUT", textcolor = color.white, size = size.small)

var table tb = table.new(position.top_right, 1, 3, bgcolor = color.new(color.black, 30))
if barstate.islast
    table.cell(tb, 0, 0, "WL Trend: " + (inTrend ? "IN (long spot)" : "OUT (cash)"), text_color = inTrend ? #13b886 : #e8213a)
    table.cell(tb, 0, 1, "Close vs daily EMA" + str.tostring(len) + ": " + str.tostring((dClose / dEma - 1) * 100, "#.##") + "%", text_color = color.white)
    table.cell(tb, 0, 2, "Vol-sized hint: " + str.tostring(sizeHint * 100, "#") + "% of capital", text_color = color.white)
